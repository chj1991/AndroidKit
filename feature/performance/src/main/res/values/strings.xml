<resources>
    <string name="feature_performance_title">StrictMode Lab</string>
    <string name="feature_performance_enable">启用 StrictMode（检测主线程违规）</string>
    <string name="feature_performance_disk">主线程写文件（触发 DiskWrite）</string>
    <string name="feature_performance_sleep">主线程 sleep 300ms（卡顿演示）</string>
    <string name="feature_performance_tips">要点：StrictMode 用于开发期发现主线程 IO/泄漏迹象。踩坑：penaltyDeath 太激进，Demo 用 log + flash；正式环境务必关闭。</string>

    <string name="feature_performance_leak_title">Leak Lab（LeakCanary）</string>
    <string name="feature_performance_leak_create">① 制造泄漏（持有 Activity）</string>
    <string name="feature_performance_leak_recreate">② recreate 触发 onDestroy</string>
    <string name="feature_performance_leak_fix">修复（改用 ApplicationContext）</string>
    <string name="feature_performance_leak_clear">清除引用</string>
    <string name="feature_performance_leak_risk_yes">风险：recreate/退出后旧 Activity 无法回收 → LeakCanary 应报警</string>
    <string name="feature_performance_leak_risk_no">当前无明显 Activity 泄漏持有</string>
    <string name="feature_performance_leak_canary_debug">LeakCanary：已集成（debug）。流程：① 制造泄漏 → ② recreate → 等通知/桌面鸭图标 → 查看泄漏链路（LeakyActivityHolder）。</string>
    <string name="feature_performance_leak_canary_release">LeakCanary：当前非 debug 构建，未打包检测库。</string>
    <string name="feature_performance_leak_tips">要点：单例/静态不要持有 Activity/View；持有 applicationContext 相对安全。LeakCanary 仅 debugImplementation，release 零侵入。踩坑：匿名内部类、Handler、未反注册监听器。</string>

    <string name="feature_performance_startup_title">Startup Lab</string>
    <string name="feature_performance_startup_app_cost">本次 Application.onCreate 约 %1$d ms</string>
    <string name="feature_performance_startup_app_cost_unknown">尚未记录 Application.onCreate 耗时</string>
    <string name="feature_performance_startup_serial">模拟串行初始化</string>
    <string name="feature_performance_startup_parallel">模拟并行初始化</string>
    <string name="feature_performance_startup_checklist">清单：\n1. Application 只做必要同步初始化\n2. 重任务延后到首帧后 / 子线程\n3. 使用启动主题减少白屏\n4. 关注 Baseline Profile / App Startup 库（进阶）</string>
    <string name="feature_performance_startup_tips">要点：减少主线程同步工作，能并行就并行。踩坑：把网络/磁盘塞进 Application.onCreate 会明显拖慢冷启动。</string>
    <string name="feature_performance_baseline_title">Baseline Profile Lab</string>
    <string name="feature_performance_baseline_open_startup">打开 Startup Lab</string>
    <string name="feature_performance_baseline_refresh">刷新说明</string>

    <string name="feature_performance_log_title">Log Viewer（Timber）</string>
    <string name="feature_performance_log_tips">Timber.DebugTree → Logcat；InMemoryLogTree → 本页缓冲。AppLog 已桥接到 Timber。可过滤级别、打样例、复制、清空。</string>
