<?xml version="1.0" encoding="utf-8"?>
<!-- 对照 BasicUI 底部 Dialog：白底 + 顶部圆角 + ActionSheet 条目 -->
<com.peakmain.ui.widget.ShapeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:shapeLlBackgroundColor="@android:color/white"
    app:shapeLlTopLeftRadius="12dp"
    app:shapeLlTopRightRadius="12dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:text="BasicUI AlertDialog"
        android:textColor="#FF4A4A4A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFF0F0F0" />

    <TextView
        android:id="@+id/tvDialogAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="自定义内容 / 底部弹出 / 全宽"
        android:textColor="#FF4A4A4A"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="#FFF0F0F0" />

    <TextView
        android:id="@+id/btnDialogOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="取消"
        android:textColor="#FF4A4A4A"
        android:textSize="16sp" />
</com.peakmain.ui.widget.ShapeLinearLayout>
