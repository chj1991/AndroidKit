    <string name="feature_system_bubble_default_message">来自 AndroidKit 的气泡内容</string>
    <string name="feature_system_bubble_close">关闭</string>
    <string name="feature_system_notification_tips">要点：\n• 进度：同一 notifyId 反复更新 setProgress；ongoing 直到完成。\n• 大图：BigPictureStyle，展开后显示大图。\n• 气泡：Android 11+，需 Shortcut + BubbleMetadata + 系统允许气泡；部分 OEM 可能弱化气泡入口。\n踩坑：渠道 importance 以用户设置为准；气泡 Intent 需 FLAG_MUTABLE。</string>

    <string name="feature_system_fg_title">Foreground Service Lab</string>
    <string name="feature_system_fg_start">启动前台计时</string>
    <string name="feature_system_fg_stop">停止服务</string>
    <string name="feature_system_fg_running">运行中：%1$d 秒</string>
    <string name="feature_system_fg_idle">已停止（累计 %1$d 秒）</string>
    <string name="feature_system_fg_need_notification">请先在 Permission Lab 授予通知权限</string>
    <string name="feature_system_fg_tips">要点：startForegroundService + 通知；Android 10+ 需声明 foregroundServiceType。踩坑：API 33+ 无通知权限时前台通知可能不可见。</string>

    <string name="feature_system_share_title">FileProvider Lab</string>
    <string name="feature_system_share_create">创建缓存文本文件</string>
    <string name="feature_system_share_send">分享文件</string>
    <string name="feature_system_share_chooser">分享到</string>
    <string name="feature_system_share_tips">要点：通过 FileProvider 生成 content:// URI，并授予临时读权限。踩坑：Android 7+ 禁止 file:// 跨应用暴露，authority 需与 Manifest 一致。</string>

    <string name="feature_system_broadcast_title">Broadcast Lab</string>
    <string name="feature_system_broadcast_register">动态注册 Receiver</string>
    <string name="feature_system_broadcast_send">发送应用内广播</string>
    <string name="feature_system_broadcast_status_on">已注册（RECEIVER_NOT_EXPORTED）</string>
    <string name="feature_system_broadcast_status_off">未注册</string>
    <string name="feature_system_broadcast_tips">要点：隐式广播静态注册受限，优先动态注册 + 显式/包名限定。踩坑：Android 13+ 注册需声明 exported 标志。</string>

    <string name="feature_system_biometric_title">Biometric Lab</string>
    <string name="feature_system_biometric_tips">BiometricPrompt 统一指纹 / 面部 / 虹膜；Weak 可含 2D 面容，Strong 为 Class 3。含 DEVICE_CREDENTIAL 时可回退锁屏 PIN。演示：密码登录 → 开启生物识别 → 退出 → 生物识别再登。</string>
