    <string name="feature_image_title">Image Lab（Coil）</string>
    <string name="feature_image_preview">预览图</string>
    <string name="feature_image_load_success">加载成功图</string>
    <string name="feature_image_load_fail">失败（error 图）</string>
    <string name="feature_image_clear">清空（fallback）</string>
    <string name="feature_image_reload_style">按当前样式重载</string>
    <string name="feature_image_style_label">Transformation 样式</string>
    <string name="feature_image_style_none">原图</string>
    <string name="feature_image_style_rounded">圆角</string>
    <string name="feature_image_style_circle">圆形</string>
    <string name="feature_image_style_gray">灰度</string>
    <string name="feature_image_style_rounded_gray">圆角+灰度</string>
    <string name="feature_image_size_label">解码尺寸（采样优化）</string>
    <string name="feature_image_size_view">按 View</string>
    <string name="feature_image_size_downsample">强制缩小</string>
    <string name="feature_image_size_original">原图尺寸</string>
    <string name="feature_image_tips">要点：placeholder / error / fallback；crossfade；RoundedCorners / CircleCrop / 自定义 Grayscale。Transformation 会写入 cacheKey。大图务必用 size 采样，列表用 ViewTarget 绑定生命周期。缓存策略见 Coil Cache Lab。</string>
    <string name="feature_image_picker_title">Photo Picker Lab</string>
    <string name="feature_image_picker_pick">打开 Photo Picker</string>
    <string name="feature_image_picker_tips">要点：Android Photo Picker 通过 Activity Result 返回 content Uri，通常无需申请存储/相册权限。低版本系统会走兼容实现。对比：旧方案 READ_EXTERNAL_STORAGE / ACTION_OPEN_DOCUMENT 权限与体验不同。</string>
    <string name="feature_image_custom_title">Custom Image Picker</string>
    <string name="feature_image_custom_select_title">选择图片</string>
    <string name="feature_image_custom_max_hint">可选张数（默认 1）</string>
    <string name="feature_image_custom_apply">应用张数</string>
    <string name="feature_image_custom_open">打开选择界面</string>
    <string name="feature_image_custom_permission">申请相册权限</string>
    <string name="feature_image_custom_reload">刷新相册</string>
    <string name="feature_image_custom_confirm">确认并返回</string>
    <string name="feature_image_custom_cancel">取消</string>
    <string name="feature_image_custom_clear">清空结果</string>
    <string name="feature_image_custom_result_title">选择结果</string>
    <string name="feature_image_custom_preview_empty">从选择界面确认返回后，在此预览首张并列出全部 Uri</string>
    <string name="feature_image_custom_preview_meta">已确认 %1$d 张：\n%2$s</string>
    <string name="feature_image_custom_tips">流程：本页配置张数 → 打开独立选择界面 → 确认后 Fragment Result 返回本页展示。张数=1 单选，&gt;1 多选。</string>
    <string name="feature_image_camerax_title">CameraX Lab</string>
    <string name="feature_image_camerax_permission">申请相机权限</string>
    <string name="feature_image_camerax_capture">拍照</string>
    <string name="feature_image_camerax_tips">要点：CameraX 用 lifecycle 绑定 Preview + ImageCapture；拍照写入 cacheDir。模拟器需虚拟场景或 webcam。</string>
    <string name="feature_image_cache_title">Coil Cache Lab</string>
    <string name="feature_image_cache_tips">要点：Coil 可分别控制 memoryCachePolicy / diskCachePolicy。同一 URL 二次加载时观察 dataSource（MEMORY_CACHE / DISK / NETWORK）。</string>
    <string name="feature_image_cache_default">默认双缓存</string>
    <string name="feature_image_cache_memory">仅内存</string>
    <string name="feature_image_cache_disk">仅磁盘</string>
    <string name="feature_image_cache_disabled">禁用缓存</string>
    <string name="feature_image_cache_load">按当前策略加载</string>
</resources>
