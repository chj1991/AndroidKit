    <string name="feature_image_custom_max_hint">可选张数（默认 1）</string>
    <string name="feature_image_custom_apply">应用张数</string>
    <string name="feature_image_custom_open">打开选择界面</string>
    <string name="feature_image_custom_permission">申请相册权限</string>
    <string name="feature_image_custom_reload">刷新相册</string>
    <string name="feature_image_custom_confirm">确认并返回</string>
    <string name="feature_image_custom_cancel">取消</string>
    <string name="feature_image_custom_clear">清空结果</string>
    <string name="feature_image_custom_result_title">选择结果</string>
    <string name="feature_image_custom_preview_empty">从选择界面确认返回后，在此预览首张并列出全部 Uri</string>
    <string name="feature_image_custom_preview_meta">已确认 %1$d 张：\n%2$s</string>
    <string name="feature_image_custom_tips">流程：本页配置张数 → 打开独立选择界面 → 确认后 Fragment Result 返回本页展示。张数=1 单选，&gt;1 多选。</string>
