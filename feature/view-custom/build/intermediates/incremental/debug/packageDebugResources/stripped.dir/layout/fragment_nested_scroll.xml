<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/feature_view_nested_title" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchChildWins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:padding="16dp"
        android:text="@string/feature_view_nested_switch" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/feature_view_nested_tips"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#E3F2FD"
                android:gravity="center"
                android:text="@string/feature_view_nested_block_top"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.sys.androidkit.feature.viewcustom.LockableHorizontalScrollView
                android:id="@+id/horizontalScroller"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginVertical="12dp"
                android:background="#FFF3E0"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="220dp"
                        android:layout_height="match_parent"
                        android:background="#FFE0B2"
                        android:gravity="center"
                        android:text="横向卡片 1 →" />

                    <TextView
                        android:layout_width="220dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="#FFCC80"
                        android:gravity="center"
                        android:text="横向卡片 2 →" />

                    <TextView
                        android:layout_width="220dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="#FFB74D"
                        android:gravity="center"
                        android:text="横向卡片 3 →" />

                    <TextView
                        android:layout_width="220dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="#FFA726"
                        android:gravity="center"
                        android:text="横向卡片 4" />
                </LinearLayout>
            </com.sys.androidkit.feature.viewcustom.LockableHorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:background="#E8F5E9"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/feature_view_nested_block_bottom"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
